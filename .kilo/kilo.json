{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": [".kilo/global-rules.md", ".kilo/project-rules.md"],
  "skills": {
    "paths": [".kilo/skills"]
  },
  "mcp": {
    "gitnexus": {
      "type": "local",
      "command": ["npx", "-y", "gitnexus@latest", "mcp"]
    },
    "codegraphcontext": {
      "type": "local",
      "command": ["uv", "run", "cgc", "mcp"],
      "workdir": "."
    }
  }
}